{
 "title": "kubecapybara",
 "uid": "kubecapybara",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "refresh": "30s",
 "tags": [
  "kubecapybara",
  "ebpf"
 ],
 "templating": {
  "list": [
   {
    "name": "datasource",
    "type": "datasource",
    "query": "prometheus",
    "label": "Prometheus"
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "TCP RTT p99 by client \u2192 server",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.99, sum by (client, server, port, le) (rate(capybara_tcp_rtt_seconds_bucket[5m])))",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "New TCP connections / s",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (owner) (rate(capybara_tcp_connections_total{side=\"client\"}[5m]))",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "TCP retransmits / s",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (client, server, port) (rate(capybara_tcp_retransmits_total[5m])) > 0",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Refused + timed out connects / s",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (owner, server, port) (rate(capybara_tcp_refused_total[5m]) + rate(capybara_tcp_connect_timeouts_total[5m])) > 0",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "DNS latency p99 by pod",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.99, sum by (entity, pod_uid, le) (rate(capybara_dns_latency_seconds_bucket[5m])))",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "DNS failures / s (SERVFAIL, REFUSED)",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (entity, pod_uid) (rate(capybara_dns_responses_total{rcode=~\"SERVFAIL|REFUSED\"}[5m])) > 0",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "CPU run queue latency p99 by pod",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.99, sum by (entity, pod_uid, le) (rate(capybara_runqueue_latency_seconds_bucket[5m])))",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Waiting for CPU (cores)",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (entity, pod_uid) (rate(capybara_offcpu_seconds_total{state=\"runq\"}[5m]))",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "HTTP requests / s (server)",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 32
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (entity, pod_uid, status) (rate(capybara_http_requests_total{role=\"server\"}[5m]))",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "HTTP latency p99 (server)",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 32
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.99, sum by (entity, pod_uid, le) (rate(capybara_http_latency_seconds_bucket{role=\"server\"}[5m])))",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Database latency p99",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 40
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.99, sum by (entity, db, le) (rate(capybara_db_latency_seconds_bucket[5m])))",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Database errors / s",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 40
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (entity, db, statement) (rate(capybara_db_errors_total[5m])) > 0",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Accept queue overflows / s",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 48
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (entity, pod_uid) (rate(capybara_tcp_listen_overflows_total[5m])) > 0",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Packet drops / s by reason",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 48
   },
   "fieldConfig": {
    "defaults": {
     "unit": "pps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (reason) (rate(capybara_packet_drops_total[5m]))",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 15,
   "type": "timeseries",
   "title": "Conntrack table usage",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 56
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "capybara_conntrack_entries / capybara_conntrack_max",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 16,
   "type": "timeseries",
   "title": "Time in slow file operations",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 56
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (entity, path, fs) (rate(capybara_slow_file_wait_seconds_total[5m])) > 0",
     "legendFormat": ""
    }
   ]
  }
 ]
}